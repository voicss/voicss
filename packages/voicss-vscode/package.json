{
	"name": "voicss-vscode",
	"displayName": "Voicss",
	"version": "0.0.0",
	"description": "✨ Native CSS Features for Voicss",
	"author": "kh4f",
	"publisher": "kh4f",
	"license": "MIT",
	"repository": "https://github.com/kh4f/voicss-vscode",
	"homepage": "https://github.com/kh4f/voicss-vscode",
	"bugs": "https://github.com/kh4f/voicss-vscode/issues",
	"keywords": ["voicss", "css-in-ts", "css-in-js", "typescript", "syntax-highlighting"],
	"categories": ["Programming Languages", "Formatters", "Snippets", "Linters"],
	"icon": "icon.png",
	"galleryBanner": { "color": "#271B19", "theme": "dark" },
	"engines": { "vscode": ">=1.136.0" },
	"files": ["package.json", "README.md", "LICENSE", "CHANGELOG.md", "dist", "syntaxes", "icon.png"],
	"type": "module",
	"main": "dist/client.mjs",
	"activationEvents": ["onLanguage:typescript", "onLanguage:typescriptreact"],
	"contributes": {
		"grammars": [{
			"scopeName": "voicss.css.injection",
			"path": "syntaxes/injection.json",
			"injectTo": ["source.ts", "source.tsx"],
			"embeddedLanguages": { "meta.embedded.block.css": "css" }
		}]
	},
	"scripts": {
		"build": "tsdown",
		"lint": "tsc && eslint"
	},
	"devDependencies": {
		"@types/vscode": "^1.136.0",
		"@vscode/emmet-helper": "^2.11.0",
		"@vscode/vsce": "^3.9.2",
		"vscode-css-languageservice": "^6.3.10",
		"vscode-languageclient": "^10.1.1",
		"vscode-languageserver": "^10.1.1",
		"vscode-languageserver-textdocument": "^1.0.14"
	}
}